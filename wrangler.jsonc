{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy00",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b273b92b-8621-40fa-b3ec-9211c888718a","database_name": "nova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "02b1fe8459a348a8a07fc24e5b23e9bb" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
